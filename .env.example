# Postgres (Railway)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Resend (magic-link email)
# EMAIL_FROM must be at a verified Resend domain to deliver to anyone
# other than the Resend account holder. The shared `onboarding@resend.dev`
# only delivers to your own verified address — useful for solo dev only.
RESEND_API_KEY=
EMAIL_FROM=invites@directory.coffeewithjason.com

# Cloudflare R2 (profile photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=100cups-profile-photos
R2_PUBLIC_URL=
