# Postgres (Railway)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft OAuth — portal.azure.com → App registrations
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# LinkedIn OAuth — developer.linkedin.com → My Apps
# Authorized redirect URL: http://localhost:3000/api/auth/callback/linkedin
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Cloudflare R2 (profile photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=100cups-profile-photos
R2_PUBLIC_URL=
