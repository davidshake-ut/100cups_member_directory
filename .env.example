# Postgres (Railway)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# SMTP (for sign-in code emails)
# Gmail: enable 2FA on the account, then generate an App Password at
#   myaccount.google.com/apppasswords
# Set EMAIL_FROM to the same address as SMTP_USER when using Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Cloudflare R2 (profile photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=100cups-profile-photos
R2_PUBLIC_URL=
